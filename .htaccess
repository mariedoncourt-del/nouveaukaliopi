# =============================================================================
# Kaliopi - Configuration Apache + Sécurité (Section 9 bis P1.3)
# =============================================================================

RewriteEngine on

# -----------------------------------------------------------------------------
# 1. En-têtes HTTP de sécurité (P1.3)
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    # HSTS : force HTTPS pendant 1 an, à activer SEULEMENT après bascule HTTPS confirmée
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Empêche le sniffing MIME (un .txt ne sera pas interprété comme JS)
    Header always set X-Content-Type-Options "nosniff"

    # Anti-clickjacking : Kaliopi ne doit pas être embarqué dans des iframes externes
    Header always set X-Frame-Options "SAMEORIGIN"

    # Limite la fuite d'URL via le Referer vers les sites externes
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Désactive les API navigateur sensibles non utilisées par Kaliopi
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Content-Security-Policy : à démarrer en mode Report-Only pendant 2-4 semaines,
    # puis basculer en mode bloquant. Adapter les CDN selon les libs réellement utilisées
    # (Bootstrap, jQuery, DataTables, FontAwesome, Google Fonts).
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://code.jquery.com https://cdn.datatables.net https://cdn.jsdelivr.net https://stackpath.bootstrapcdn.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.datatables.net https://cdn.jsdelivr.net https://stackpath.bootstrapcdn.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

    # Retire l'en-tête révélant la version de PHP
    Header unset X-Powered-By
</IfModule>

# -----------------------------------------------------------------------------
# 2. Désactivation de la signature serveur
# -----------------------------------------------------------------------------
ServerSignature Off

# -----------------------------------------------------------------------------
# 3. Blocage des fichiers sensibles (P1.4)
# -----------------------------------------------------------------------------
<FilesMatch "^(\.htaccess|\.htpasswd|\.git.*|composer\.json|composer\.lock|\.env|\.env\.example|README\.md|SECURITY\.md|.*\.bak|.*\.sql|.*\.log)$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Blocage des fichiers de backup laissés par mégarde (*2602.php, *.bak, *~, etc.)
<FilesMatch "(2602\.php|~$|\.swp$|\.orig$)">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------------
# 4. Redirection HTTPS forcée (à activer une fois HTTPS confirmé en production)
# -----------------------------------------------------------------------------
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !=https
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# -----------------------------------------------------------------------------
# 5. Routage CodeIgniter (existant)
# -----------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?/$1 [L,QSA]

# -----------------------------------------------------------------------------
# 6. Protection des dossiers d'upload (P1.4)
# -----------------------------------------------------------------------------
# Empêche l'exécution de scripts PHP/CGI dans les dossiers d'upload
<DirectoryMatch "^.*/(assets/uploads|assets/cv|assets/scenarios|assets/programmes|assets/files|assets/videos|assets/supports)/">
    <FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|php8|pl|py|jsp|asp|sh|cgi|htaccess)$">
        Require all denied
        <IfModule !mod_authz_core.c>
            Order deny,allow
            Deny from all
        </IfModule>
    </FilesMatch>
</DirectoryMatch>
