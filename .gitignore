# Dossiers système
application/cache/*
!application/cache/index.html
application/logs/*
!application/logs/index.html

# Librairies lourdes (seront réinstallées via Composer si besoin)
application/libraries/dompdf/lib/fonts/*.ttf
application/libraries/dompdf/lib/fonts/*.afm
application/libraries/dompdf/lib/fonts/*.ufm
application/third_party/PHPExcel-1.8/

# Assets lourds
assets/img/*
assets/certificat/*
assets/cv/*
assets/pj/*
assets/support/*
assets/pdf/*

# Uploads
uploads/*

# Config locale
application/config/database.php.local
.env
.env.local
.env.*.local

# SECURITY - Cache rate limiting (ne pas committer les compteurs de tentatives)
application/cache/rate_limit/*
!application/cache/rate_limit/.htaccess

# SECURITY - Backups SQL
*.sql.bak
backup_*.sql
dump_*.sql

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
